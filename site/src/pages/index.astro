---
import Layout from "../layouts/Layout.astro";
import MathExpression from "../components/demo-kit/MathExpression.astro";
---

<Layout title="Engineering Portfolio — Akwasi Akosah">
  <h1>Engineering Portfolio</h1>
  <p>
    A public, interactive showcase of Dartmouth Thayer School engineering coursework
    by <strong>Akwasi Akosah</strong>. Framed as a portfolio of record, not a job-search
    site.
  </p>

  <p>
    Math renders at build time — for example, the kinetic-energy identity
    <MathExpression latex={String.raw`E = \frac{1}{2} m v^2`} /> or the Gaussian integral
  </p>

  <MathExpression
    latex={String.raw`\int_{-\infty}^{\infty} e^{-x^2}\, dx = \sqrt{\pi}`}
    display={true}
  />

  <h2>Status</h2>
  <p>
    🚧 <em>v0 — scaffold deployed.</em> The full site is under construction; follow
    progress at
    <a href="https://github.com/Akosah285/engineering-portfolio/issues"
      >github.com/Akosah285/engineering-portfolio</a
    >.
  </p>

  <h2>Coming soon — 9 courses</h2>
  <ul>
    <li>Machine Learning &amp; Statistical Data Analysis</li>
    <li>Fourier Transforms &amp; Complex Variables</li>
    <li>Discrete &amp; Probabilistic Systems</li>
    <li>Computational Methods</li>
    <li>Solid Mechanics</li>
    <li>Distributed Systems &amp; Fields</li>
    <li>Mechatronics</li>
    <li>Digital Electronics</li>
    <li>Embedded Systems</li>
  </ul>
</Layout>

