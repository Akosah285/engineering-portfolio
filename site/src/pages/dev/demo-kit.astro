---
/**
 * Demo-kit pattern shakedown page (hidden from production nav).
 *
 * Lives at /_dev/demo-kit/ — only reachable by typing the URL. Used as
 * a build-time verification that the `algorithm.ts?raw` extraction
 * pattern + <CodeReveal> integration produce highlighted, collapsible
 * output with zero runtime JS.
 */
import Layout from "../../layouts/Layout.astro";
import CodeReveal from "../../components/demo-kit/CodeReveal.astro";
import algorithmSource from "../../components/demo-kit/__sample__/algorithm.ts?raw";
---

<Layout
  title="Demo-kit shakedown — Engineering Portfolio"
  description="Internal page that exercises the demo-kit pattern."
>
  <article class="dev-page">
    <h1>Demo-kit shakedown</h1>
    <p>
      This page is a build-time check that the <code>algorithm.ts?raw</code>
      extraction convention + <code>&lt;CodeReveal&gt;</code> component produce
      Shiki-highlighted, collapsible output with zero runtime JS.
    </p>

    <h2>One source of truth</h2>
    <p>
      The same <code>algorithm.ts</code> file is imported twice — once as a
      module (executable), once as raw text (displayable).
    </p>

    <CodeReveal code={algorithmSource} lang="typescript" />
  </article>
</Layout>

<style>
  .dev-page {
    max-width: 70ch;
    margin: 2rem auto 4rem;
    padding: 0 1rem;
  }
  .dev-page h1 {
    font-family: "Source Serif 4 Variable", Georgia, serif;
  }
  .dev-page code {
    font-family: "JetBrains Mono Variable", monospace;
    background: var(--color-code-bg);
    padding: 0.125rem 0.375rem;
    border-radius: 4px;
    font-size: 0.875rem;
  }
</style>
