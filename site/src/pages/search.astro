---
/**
 * /search/ — direct-link search page using the standard Pagefind UI.
 *
 * Plan §7.14 (Pagefind search scope) — surface 3 of 3:
 *   1. Cmd-K modal (SearchModal.astro) — opens from anywhere
 *   2. Top-nav search button (Header.astro) — opens the modal
 *   3. /search/ — this page (direct-link + SEO)
 *
 * The Pagefind bundle is generated by `pnpm run build` (postbuild step in
 * package.json runs `pagefind --site dist`). Bundle lives at
 * /pagefind/pagefind-ui.js relative to the site root.
 */
import Layout from "../layouts/Layout.astro";

const base = import.meta.env.BASE_URL;
---

<Layout
  title="Search — Engineering Portfolio"
  description="Search across courses, demos, featured problems, and concepts."
  pagefindType="search"
>
  <article class="search-page">
    <header class="search-page__header">
      <h1>Search</h1>
      <p>
        Full-text search across every course writeup, demo description,
        featured problem (including raw LaTeX), and reflection on this site.
      </p>
    </header>

    <div id="search" class="search-page__ui"></div>

    <noscript>
      <p class="search-page__noscript">
        Search requires JavaScript. The site is fully readable without it —
        browse from the <a href={base}>landing page</a> instead.
      </p>
    </noscript>
  </article>
</Layout>

<link rel="stylesheet" href={`${base}pagefind/pagefind-ui.css`} />
<script is:inline define:vars={{ base }}>
  // Standard Pagefind UI — wires up its own input, results, filters.
  // Imported lazily so the page renders before the bundle arrives.
  window.addEventListener("DOMContentLoaded", async () => {
    try {
      const mod = await import(`${base}pagefind/pagefind-ui.js`);
      const PagefindUI = mod.PagefindUI ?? mod.default?.PagefindUI;
      if (typeof PagefindUI !== "function") {
        throw new Error("Pagefind UI bundle missing PagefindUI export");
      }
      // eslint-disable-next-line no-new
      new PagefindUI({
        element: "#search",
        showSubResults: true,
        showImages: false,
        resetStyles: false,
        translations: {
          placeholder: "Search the portfolio…",
          zero_results: "No results for [SEARCH_TERM]",
        },
      });
    } catch (err) {
      const el = document.getElementById("search");
      if (el) {
        el.innerHTML = `<p class="search-page__error">Search index not available in this preview. It is generated at build time and shipped with the deployed site.</p>`;
      }
      console.error("Pagefind init failed:", err);
    }
  });
</script>

<style>
  .search-page {
    max-width: 70ch;
    margin: 0 auto;
    padding: 2rem 1rem 4rem;
  }
  .search-page__header h1 {
    font-family: "Source Serif 4 Variable", Georgia, serif;
    font-size: clamp(1.75rem, 5vw, 2.5rem);
    margin: 0 0 0.5rem;
    font-weight: 600;
  }
  .search-page__header p {
    color: var(--color-text-muted);
    line-height: 1.55;
    margin: 0 0 2rem;
  }
  .search-page__ui {
    --pagefind-ui-primary: var(--color-accent);
    --pagefind-ui-text: var(--color-text);
    --pagefind-ui-background: var(--color-surface);
    --pagefind-ui-border: var(--color-text-muted);
    --pagefind-ui-tag: var(--color-code-bg);
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 6px;
    --pagefind-ui-font: inherit;
  }
  .search-page__noscript,
  .search-page__error {
    color: var(--color-text-muted);
    font-size: 0.95rem;
    margin-top: 1.5rem;
  }
</style>
