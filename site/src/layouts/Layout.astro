---
import "@fontsource-variable/inter";
import "@fontsource-variable/source-serif-4";
import "@fontsource-variable/jetbrains-mono";
import "katex/dist/katex.min.css";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import HeadMeta from "../components/HeadMeta.astro";

interface Props {
  title: string;
  description?: string;
  ogType?: "website" | "article";
  ogImage?: string;
  ogImageAlt?: string;
  pagefindType?: string;
  pagefindCourse?: string;
}

const {
  title,
  description = "Akwasi Akosah — a public, interactive engineering portfolio of Dartmouth Thayer School coursework.",
  ogType = "website",
  ogImage,
  ogImageAlt,
  pagefindType = "page",
  pagefindCourse,
} = Astro.props;

const themeBootstrap = `
(function() {
  try {
    var stored = localStorage.getItem("theme-preference");
    var prefDark = window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches;
    var resolved = (stored === "light" || stored === "dark") ? stored : (prefDark ? "dark" : "light");
    document.documentElement.setAttribute("data-theme", resolved);
  } catch (e) {
    document.documentElement.setAttribute("data-theme", "light");
  }
})();
`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link
      rel="icon"
      type="image/svg+xml"
      href={`${import.meta.env.BASE_URL}favicon.svg`}
    />
    <HeadMeta
      title={title}
      description={description}
      ogType={ogType}
      ogImage={ogImage}
      ogImageAlt={ogImageAlt}
    />
    <script is:inline set:html={themeBootstrap} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main
      id="main"
      data-pagefind-body
      data-pagefind-meta={`type:${pagefindType}`}
      data-pagefind-filter={`type:${pagefindType}${pagefindCourse ? `, course:${pagefindCourse}` : ""}`}
    >
      <slot />
    </main>
    <Footer />
  </body>
</html>
