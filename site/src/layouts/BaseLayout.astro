---
interface Props {
  title: string;
  description?: string;
}

const { title, description = "Akwasi Akosah — engineering coursework portfolio" } =
  Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <style is:global>
      :root {
        --bg: #ffffff;
        --fg: #111111;
        --muted: #555555;
        --accent: #1a73e8;
        font-family:
          ui-sans-serif,
          system-ui,
          -apple-system,
          "Segoe UI",
          sans-serif;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --bg: #0e1014;
          --fg: #f0f0f0;
          --muted: #999;
          --accent: #8ab4f8;
        }
      }
      html,
      body {
        margin: 0;
        padding: 0;
        background: var(--bg);
        color: var(--fg);
      }
      body {
        max-width: 64ch;
        margin: 0 auto;
        padding: 2rem 1rem 4rem;
        line-height: 1.55;
      }
      a {
        color: var(--accent);
      }
    </style>
  </body>
</html>
