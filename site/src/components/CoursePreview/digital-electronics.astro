---
/**
 * Course demo preview — Digital Electronics
 *
 * Mounted inside the Coming-Soon variant of /courses/digital-electronics/ so visitors
 * can play with every demo built for this course before its written
 * reflection ships. Hero demo hydrates client:idle; the rest hydrate
 * client:visible to keep initial load cheap.
 *
 * Generated by scripts/generate-course-previews.ps1 — edit the manifest
 * there (not this file) when the demo list or descriptions change.
 */
import DemoChrome from "../demo-kit/DemoChrome.astro";
import FsmSimulatorVisualizer from "../demos/digital-electronics/fsm-simulator/FsmSimulatorVisualizer";
import AluBitSliceVisualizer from "../demos/digital-electronics/alu-bit-slice/AluBitSliceVisualizer";
import BinaryCounterVisualizer from "../demos/digital-electronics/binary-counter/BinaryCounterVisualizer";
import DatapathVisualizer from "../demos/digital-electronics/datapath/DatapathVisualizer";
import KarnaughMinimizerVisualizer from "../demos/digital-electronics/karnaugh-minimizer/KarnaughMinimizerVisualizer";
import LatchVsFfVisualizer from "../demos/digital-electronics/latch-vs-ff/LatchVsFfVisualizer";
import StopwatchFsmVisualizer from "../demos/digital-electronics/stopwatch-fsm/StopwatchFsmVisualizer";
import TruthTableVisualizer from "../demos/digital-electronics/truth-table/TruthTableVisualizer";
import VhdlWaveformVisualizer from "../demos/digital-electronics/vhdl-waveform/VhdlWaveformVisualizer";
---

<section class="preview-demos" aria-labelledby="preview-demos-heading-digital-electronics">
  <h2 id="preview-demos-heading-digital-electronics">Preview the demos (9)</h2>
  <p class="preview-demos__lede">
    The interactive demos for this course are wired and playable below. The
    written reflection and featured problems land with the full course page —
    track progress on the <a
      href="https://github.com/Akosah285/engineering-portfolio/issues"
      >issue tracker</a
    >.
  </p>

  <DemoChrome
    title="FSM simulator (stopwatch preset)"
    shareable={false}
    demoSourcePath="site/src/components/demos/digital-electronics/fsm-simulator/FsmSimulatorVisualizer.tsx"
  >
    <p class="preview-demos__desc">Build a finite state machine, step the clock, watch transitions fire.</p>
    <FsmSimulatorVisualizer client:idle />
  </DemoChrome>

  <DemoChrome
    title="ALU bit-slice explorer"
    shareable={false}
    demoSourcePath="site/src/components/demos/digital-electronics/alu-bit-slice/AluBitSliceVisualizer.tsx"
  >
    <p class="preview-demos__desc">1-bit ALU slice cascaded to 4-bit; toggle operation lines and watch results propagate.</p>
    <AluBitSliceVisualizer client:visible />
  </DemoChrome>

  <DemoChrome
    title="Counter simulator"
    shareable={false}
    demoSourcePath="site/src/components/demos/digital-electronics/binary-counter/BinaryCounterVisualizer.tsx"
  >
    <p class="preview-demos__desc">Synchronous / ripple counters with adjustable modulus and clock visualisation.</p>
    <BinaryCounterVisualizer client:visible />
  </DemoChrome>

  <DemoChrome
    title="Datapath visualizer — lab4"
    shareable={false}
    demoSourcePath="site/src/components/demos/digital-electronics/datapath/DatapathVisualizer.tsx"
  >
    <p class="preview-demos__desc">Animated datapath for the Lab 4 lifted directly from lab4_datapath.vhd.</p>
    <DatapathVisualizer client:visible />
  </DemoChrome>

  <DemoChrome
    title="Karnaugh map minimizer"
    shareable={false}
    demoSourcePath="site/src/components/demos/digital-electronics/karnaugh-minimizer/KarnaughMinimizerVisualizer.tsx"
  >
    <p class="preview-demos__desc">Type a Boolean expression; auto-derive the minimal SOP via K-map grouping.</p>
    <KarnaughMinimizerVisualizer client:visible />
  </DemoChrome>

  <DemoChrome
    title="Latch vs flip-flop"
    shareable={false}
    demoSourcePath="site/src/components/demos/digital-electronics/latch-vs-ff/LatchVsFfVisualizer.tsx"
  >
    <p class="preview-demos__desc">Level-sensitive latch vs edge-triggered flip-flop side by side with timing diagrams.</p>
    <LatchVsFfVisualizer client:visible />
  </DemoChrome>

  <DemoChrome
    title="Stopwatch FSM animation"
    shareable={false}
    demoSourcePath="site/src/components/demos/digital-electronics/stopwatch-fsm/StopwatchFsmVisualizer.tsx"
  >
    <p class="preview-demos__desc">Lab 3 stopwatch FSM with start / stop / reset transitions animated.</p>
    <StopwatchFsmVisualizer client:visible />
  </DemoChrome>

  <DemoChrome
    title="Logic gate truth table builder"
    shareable={false}
    demoSourcePath="site/src/components/demos/digital-electronics/truth-table/TruthTableVisualizer.tsx"
  >
    <p class="preview-demos__desc">Drag-and-drop gates; auto-derive the truth table and minimal Boolean expression.</p>
    <TruthTableVisualizer client:visible />
  </DemoChrome>

  <DemoChrome
    title="VHDL → animated waveform"
    shareable={false}
    demoSourcePath="site/src/components/demos/digital-electronics/vhdl-waveform/VhdlWaveformVisualizer.tsx"
  >
    <p class="preview-demos__desc">Pre-compiled VHDL test benches rendered as live waveform animations.</p>
    <VhdlWaveformVisualizer client:visible />
  </DemoChrome>
</section>

<style>
  .preview-demos {
    margin: 3rem auto 0;
    max-width: 60rem;
  }
  .preview-demos > :global(* + *) {
    margin-top: 2rem;
  }
  .preview-demos__lede {
    color: var(--color-text-muted);
    margin: 0.5rem 0 2rem;
  }
  .preview-demos__desc {
    color: var(--color-text-muted);
    font-size: 0.9375rem;
    margin: 0 0 0.75rem;
  }
</style>