---
/**
 * Course demo preview — Embedded Systems
 *
 * Mounted inside the Coming-Soon variant of /courses/embedded-systems/ so visitors
 * can play with every demo built for this course before its written
 * reflection ships. Hero demo hydrates client:idle; the rest hydrate
 * client:visible to keep initial load cheap.
 *
 * Generated by scripts/generate-course-previews.ps1 — edit the manifest
 * there (not this file) when the demo list or descriptions change.
 */
import DemoChrome from "../demo-kit/DemoChrome.astro";
import { TrafficLightVisualizer } from "../demos/embedded-systems/traffic-light/TrafficLightVisualizer";
import AccelerometerVisualizer from "../demos/embedded-systems/accelerometer/AccelerometerVisualizer";
import AdcSamplingVisualizer from "../demos/embedded-systems/adc-sampling/AdcSamplingVisualizer";
import I2cProtocolVisualizer from "../demos/embedded-systems/i2c-protocol/I2cProtocolVisualizer";
import InterruptPollingVisualizer from "../demos/embedded-systems/interrupt-polling/InterruptPollingVisualizer";
import MqttVisualizer from "../demos/embedded-systems/mqtt/MqttVisualizer";
import { PwmVisualizer } from "../demos/embedded-systems/pwm/PwmVisualizer";
import RpmVisualizer from "../demos/embedded-systems/rpm/RpmVisualizer";
import { SevenSegmentVisualizer } from "../demos/embedded-systems/seven-segment/SevenSegmentVisualizer";
import SolarTrackerVisualizer from "../demos/embedded-systems/solar-tracker/SolarTrackerVisualizer";
---

<section class="preview-demos" aria-labelledby="preview-demos-heading-embedded-systems">
  <h2 id="preview-demos-heading-embedded-systems">Preview the demos (10)</h2>
  <p class="preview-demos__lede">
    The interactive demos for this course are wired and playable below. The
    written reflection and featured problems land with the full course page —
    track progress on the <a
      href="https://github.com/Akosah285/engineering-portfolio/issues"
      >issue tracker</a
    >.
  </p>

  <DemoChrome
    title="Traffic light FSM (AIO_MQTT)"
    shareable={false}
    demoSourcePath="site/src/components/demos/embedded-systems/traffic-light/TrafficLightVisualizer.tsx"
  >
    <p class="preview-demos__desc">Lifted from AIO_MQTT_traffic_control; FSM with normal / pedestrian / night modes.</p>
    <TrafficLightVisualizer client:idle />
  </DemoChrome>

  <DemoChrome
    title="Accelerometer (DeviceMotion)"
    shareable={false}
    demoSourcePath="site/src/components/demos/embedded-systems/accelerometer/AccelerometerVisualizer.tsx"
  >
    <p class="preview-demos__desc">Live tilt visualisation using your phone's accelerometer (iOS gesture-unlock supported).</p>
    <AccelerometerVisualizer client:visible />
  </DemoChrome>

  <DemoChrome
    title="ADC sampling / aliasing"
    shareable={false}
    demoSourcePath="site/src/components/demos/embedded-systems/adc-sampling/AdcSamplingVisualizer.tsx"
  >
    <p class="preview-demos__desc">Tune the sample rate against the signal frequency; watch aliasing appear past Nyquist.</p>
    <AdcSamplingVisualizer client:visible />
  </DemoChrome>

  <DemoChrome
    title="I²C protocol visualizer"
    shareable={false}
    demoSourcePath="site/src/components/demos/embedded-systems/i2c-protocol/I2cProtocolVisualizer.tsx"
  >
    <p class="preview-demos__desc">Step through an I²C start / address / data / ack / stop transaction at the bit level.</p>
    <I2cProtocolVisualizer client:visible />
  </DemoChrome>

  <DemoChrome
    title="Interrupt vs polling"
    shareable={false}
    demoSourcePath="site/src/components/demos/embedded-systems/interrupt-polling/InterruptPollingVisualizer.tsx"
  >
    <p class="preview-demos__desc">Two side-by-side execution timelines comparing interrupt-driven and polled event handling.</p>
    <InterruptPollingVisualizer client:visible />
  </DemoChrome>

  <DemoChrome
    title="MQTT IoT message flow"
    shareable={false}
    demoSourcePath="site/src/components/demos/embedded-systems/mqtt/MqttVisualizer.tsx"
  >
    <p class="preview-demos__desc">Publish / subscribe / broker animation with QoS levels and topic wildcards.</p>
    <MqttVisualizer client:visible />
  </DemoChrome>

  <DemoChrome
    title="PWM visualizer"
    shareable={false}
    demoSourcePath="site/src/components/demos/embedded-systems/pwm/PwmVisualizer.tsx"
  >
    <p class="preview-demos__desc">Tune duty cycle and frequency; watch the average-voltage approximation drive a load.</p>
    <PwmVisualizer client:visible />
  </DemoChrome>

  <DemoChrome
    title="RPM measurement"
    shareable={false}
    demoSourcePath="site/src/components/demos/embedded-systems/rpm/RpmVisualizer.tsx"
  >
    <p class="preview-demos__desc">Reading rotational speed from encoder pulses or magnetic Hall-effect transitions.</p>
    <RpmVisualizer client:visible />
  </DemoChrome>

  <DemoChrome
    title="Seven-segment decoder"
    shareable={false}
    demoSourcePath="site/src/components/demos/embedded-systems/seven-segment/SevenSegmentVisualizer.tsx"
  >
    <p class="preview-demos__desc">Hex digit → segment-encoding map with a live BCD-to-seven-segment lookup.</p>
    <SevenSegmentVisualizer client:visible />
  </DemoChrome>

  <DemoChrome
    title="Solar tracker logic"
    shareable={false}
    demoSourcePath="site/src/components/demos/embedded-systems/solar-tracker/SolarTrackerVisualizer.tsx"
  >
    <p class="preview-demos__desc">Two-LDR comparator drives the servo toward the brighter side.</p>
    <SolarTrackerVisualizer client:visible />
  </DemoChrome>
</section>

<style>
  .preview-demos {
    margin: 3rem auto 0;
    max-width: 60rem;
  }
  .preview-demos > :global(* + *) {
    margin-top: 2rem;
  }
  .preview-demos__lede {
    color: var(--color-text-muted);
    margin: 0.5rem 0 2rem;
  }
  .preview-demos__desc {
    color: var(--color-text-muted);
    font-size: 0.9375rem;
    margin: 0 0 0.75rem;
  }
</style>