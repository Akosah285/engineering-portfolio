---
/**
 * Course demo preview — Solid Mechanics
 *
 * Mounted inside the Coming-Soon variant of /courses/solid-mechanics/ so visitors
 * can play with every demo built for this course before its written
 * reflection ships. Hero demo hydrates client:idle; the rest hydrate
 * client:visible to keep initial load cheap.
 *
 * Generated by scripts/generate-course-previews.ps1 — edit the manifest
 * there (not this file) when the demo list or descriptions change.
 */
import DemoChrome from "../demo-kit/DemoChrome.astro";
import TrussAnalyzerVisualizer from "../demos/solid-mechanics/truss-analyzer/TrussAnalyzerVisualizer";
import { BeamDeflectionVisualizer } from "../demos/solid-mechanics/beam-deflection/BeamDeflectionVisualizer";
import BendingStressVisualizer from "../demos/solid-mechanics/bending-stress/BendingStressVisualizer";
import { EulerBucklingVisualizer } from "../demos/solid-mechanics/euler-buckling/EulerBucklingVisualizer";
import FailureCriteriaVisualizer from "../demos/solid-mechanics/failure-criteria/FailureCriteriaVisualizer";
import { MohrCircleVisualizer } from "../demos/solid-mechanics/mohr-circle/MohrCircleVisualizer";
import ShearMomentVisualizer from "../demos/solid-mechanics/shear-moment/ShearMomentVisualizer";
import Stress3dVisualizer from "../demos/solid-mechanics/stress-3d/Stress3dVisualizer";
import { StressStrainVisualizer } from "../demos/solid-mechanics/stress-strain/StressStrainVisualizer";
import { TorsionVisualizer } from "../demos/solid-mechanics/torsion/TorsionVisualizer";
---

<section class="preview-demos" aria-labelledby="preview-demos-heading-solid-mechanics">
  <h2 id="preview-demos-heading-solid-mechanics">Preview the demos (10)</h2>
  <p class="preview-demos__lede">
    The interactive demos for this course are wired and playable below. The
    written reflection and featured problems land with the full course page —
    track progress on the <a
      href="https://github.com/Akosah285/engineering-portfolio/issues"
      >issue tracker</a
    >.
  </p>

  <DemoChrome
    title="Interactive truss analyzer"
    shareable={false}
    demoSourcePath="site/src/components/demos/solid-mechanics/truss-analyzer/TrussAnalyzerVisualizer.tsx"
  >
    <p class="preview-demos__desc">Build a 2D truss, apply loads, solve for member forces via method of joints.</p>
    <TrussAnalyzerVisualizer client:idle />
  </DemoChrome>

  <DemoChrome
    title="Beam deflection calculator"
    shareable={false}
    demoSourcePath="site/src/components/demos/solid-mechanics/beam-deflection/BeamDeflectionVisualizer.tsx"
  >
    <p class="preview-demos__desc">Cantilever / simply-supported / fixed-fixed beams under point or distributed load.</p>
    <BeamDeflectionVisualizer client:visible />
  </DemoChrome>

  <DemoChrome
    title="Bending stress distribution"
    shareable={false}
    demoSourcePath="site/src/components/demos/solid-mechanics/bending-stress/BendingStressVisualizer.tsx"
  >
    <p class="preview-demos__desc">σ = My/I across a beam cross-section, with neutral-axis visualisation.</p>
    <BendingStressVisualizer client:visible />
  </DemoChrome>

  <DemoChrome
    title="Euler buckling calculator"
    shareable={false}
    demoSourcePath="site/src/components/demos/solid-mechanics/euler-buckling/EulerBucklingVisualizer.tsx"
  >
    <p class="preview-demos__desc">Critical buckling load vs slenderness ratio for the four boundary cases.</p>
    <EulerBucklingVisualizer client:visible />
  </DemoChrome>

  <DemoChrome
    title="Failure criteria explorer"
    shareable={false}
    demoSourcePath="site/src/components/demos/solid-mechanics/failure-criteria/FailureCriteriaVisualizer.tsx"
  >
    <p class="preview-demos__desc">Tresca vs von Mises vs maximum-normal-stress envelopes in σ1-σ2 space.</p>
    <FailureCriteriaVisualizer client:visible />
  </DemoChrome>

  <DemoChrome
    title="Mohr's circle"
    shareable={false}
    demoSourcePath="site/src/components/demos/solid-mechanics/mohr-circle/MohrCircleVisualizer.tsx"
  >
    <p class="preview-demos__desc">Drag the stress element; watch the Mohr's circle and principal stresses update.</p>
    <MohrCircleVisualizer client:visible />
  </DemoChrome>

  <DemoChrome
    title="Shear & moment diagrams"
    shareable={false}
    demoSourcePath="site/src/components/demos/solid-mechanics/shear-moment/ShearMomentVisualizer.tsx"
  >
    <p class="preview-demos__desc">Place supports and loads; auto-derive the V and M diagrams along the beam.</p>
    <ShearMomentVisualizer client:visible />
  </DemoChrome>

  <DemoChrome
    title="3D stress state visualizer"
    shareable={false}
    demoSourcePath="site/src/components/demos/solid-mechanics/stress-3d/Stress3dVisualizer.tsx"
  >
    <p class="preview-demos__desc">Stress tensor on a unit cube; rotate to explore principal stresses.</p>
    <Stress3dVisualizer client:visible />
  </DemoChrome>

  <DemoChrome
    title="Stress-strain curve"
    shareable={false}
    demoSourcePath="site/src/components/demos/solid-mechanics/stress-strain/StressStrainVisualizer.tsx"
  >
    <p class="preview-demos__desc">Elastic / yield / plastic / necking regions for common engineering materials.</p>
    <StressStrainVisualizer client:visible />
  </DemoChrome>

  <DemoChrome
    title="Torsion of shafts"
    shareable={false}
    demoSourcePath="site/src/components/demos/solid-mechanics/torsion/TorsionVisualizer.tsx"
  >
    <p class="preview-demos__desc">Shear stress and angle of twist for a circular shaft under applied torque.</p>
    <TorsionVisualizer client:visible />
  </DemoChrome>
</section>

<style>
  .preview-demos {
    margin: 3rem auto 0;
    max-width: 60rem;
  }
  .preview-demos > :global(* + *) {
    margin-top: 2rem;
  }
  .preview-demos__lede {
    color: var(--color-text-muted);
    margin: 0.5rem 0 2rem;
  }
  .preview-demos__desc {
    color: var(--color-text-muted);
    font-size: 0.9375rem;
    margin: 0 0 0.75rem;
  }
</style>