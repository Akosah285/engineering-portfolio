---
/**
 * Course demo preview — Discrete & Probabilistic Systems
 *
 * Mounted inside the Coming-Soon variant of /courses/discrete-probability/ so visitors
 * can play with every demo built for this course before its written
 * reflection ships. Hero demo hydrates client:idle; the rest hydrate
 * client:visible to keep initial load cheap.
 *
 * Generated by scripts/generate-course-previews.ps1 — edit the manifest
 * there (not this file) when the demo list or descriptions change.
 */
import DemoChrome from "../demo-kit/DemoChrome.astro";
import { MarkovChainVisualizer } from "../demos/discrete-probability/markov-chain/MarkovChainVisualizer";
import { BayesTheoremVisualizer } from "../demos/discrete-probability/bayes-theorem/BayesTheoremVisualizer";
import { BirthdayParadoxVisualizer } from "../demos/discrete-probability/birthday-paradox/BirthdayParadoxVisualizer";
import { CentralLimitVisualizer } from "../demos/discrete-probability/central-limit/CentralLimitVisualizer";
import { CombinatoricsVisualizer } from "../demos/discrete-probability/combinatorics/CombinatoricsVisualizer";
import { ErdosRenyiVisualizer } from "../demos/discrete-probability/erdos-renyi/ErdosRenyiVisualizer";
import { GamblersRuinVisualizer } from "../demos/discrete-probability/gamblers-ruin/GamblersRuinVisualizer";
import { HypothesisTestingVisualizer } from "../demos/discrete-probability/hypothesis-testing/HypothesisTestingVisualizer";
import { MonteCarloPiVisualizer } from "../demos/discrete-probability/monte-carlo-pi/MonteCarloPiVisualizer";
import { PageRankVisualizer } from "../demos/discrete-probability/page-rank/PageRankVisualizer";
---

<section class="preview-demos" aria-labelledby="preview-demos-heading-discrete-probability">
  <h2 id="preview-demos-heading-discrete-probability">Preview the demos (10)</h2>
  <p class="preview-demos__lede">
    The interactive demos for this course are wired and playable below. The
    written reflection and featured problems land with the full course page —
    track progress on the <a
      href="https://github.com/Akosah285/engineering-portfolio/issues"
      >issue tracker</a
    >.
  </p>

  <DemoChrome
    title="Markov chain visualizer"
    shareable={false}
    demoSourcePath="site/src/components/demos/discrete-probability/markov-chain/MarkovChainVisualizer.tsx"
  >
    <p class="preview-demos__desc">Drag transition probabilities, step the chain, watch the stationary distribution emerge.</p>
    <MarkovChainVisualizer client:idle />
  </DemoChrome>

  <DemoChrome
    title="Bayes' theorem"
    shareable={false}
    demoSourcePath="site/src/components/demos/discrete-probability/bayes-theorem/BayesTheoremVisualizer.tsx"
  >
    <p class="preview-demos__desc">Sliders for prior, likelihood, and false-positive rate; live posterior + 2x2 table.</p>
    <BayesTheoremVisualizer client:visible />
  </DemoChrome>

  <DemoChrome
    title="Birthday paradox simulator"
    shareable={false}
    demoSourcePath="site/src/components/demos/discrete-probability/birthday-paradox/BirthdayParadoxVisualizer.tsx"
  >
    <p class="preview-demos__desc">Drag the room size and watch the collision probability climb past 50% near 23 people.</p>
    <BirthdayParadoxVisualizer client:visible />
  </DemoChrome>

  <DemoChrome
    title="Central limit theorem"
    shareable={false}
    demoSourcePath="site/src/components/demos/discrete-probability/central-limit/CentralLimitVisualizer.tsx"
  >
    <p class="preview-demos__desc">Pick a base distribution, stack the sample means, watch a Gaussian emerge.</p>
    <CentralLimitVisualizer client:visible />
  </DemoChrome>

  <DemoChrome
    title="Combinations & permutations"
    shareable={false}
    demoSourcePath="site/src/components/demos/discrete-probability/combinatorics/CombinatoricsVisualizer.tsx"
  >
    <p class="preview-demos__desc">Calculator + visual enumeration for nPk and nCk with small n.</p>
    <CombinatoricsVisualizer client:visible />
  </DemoChrome>

  <DemoChrome
    title="Erdős-Rényi random graph"
    shareable={false}
    demoSourcePath="site/src/components/demos/discrete-probability/erdos-renyi/ErdosRenyiVisualizer.tsx"
  >
    <p class="preview-demos__desc">Tune the edge probability p and watch the giant component appear past the threshold.</p>
    <ErdosRenyiVisualizer client:visible />
  </DemoChrome>

  <DemoChrome
    title="Gambler's ruin / Monte Carlo"
    shareable={false}
    demoSourcePath="site/src/components/demos/discrete-probability/gamblers-ruin/GamblersRuinVisualizer.tsx"
  >
    <p class="preview-demos__desc">Biased coin walks to ruin or fortune; theoretical vs simulated absorption probabilities.</p>
    <GamblersRuinVisualizer client:visible />
  </DemoChrome>

  <DemoChrome
    title="Hypothesis testing"
    shareable={false}
    demoSourcePath="site/src/components/demos/discrete-probability/hypothesis-testing/HypothesisTestingVisualizer.tsx"
  >
    <p class="preview-demos__desc">Visualise α, β, p-values and effect size for a one-sided z-test.</p>
    <HypothesisTestingVisualizer client:visible />
  </DemoChrome>

  <DemoChrome
    title="Monte Carlo π estimator"
    shareable={false}
    demoSourcePath="site/src/components/demos/discrete-probability/monte-carlo-pi/MonteCarloPiVisualizer.tsx"
  >
    <p class="preview-demos__desc">Drop random darts into a unit square; convergence of 4·hits/total to π.</p>
    <MonteCarloPiVisualizer client:visible />
  </DemoChrome>

  <DemoChrome
    title="PageRank toy"
    shareable={false}
    demoSourcePath="site/src/components/demos/discrete-probability/page-rank/PageRankVisualizer.tsx"
  >
    <p class="preview-demos__desc">Tiny web graph; power-iteration converges to the dominant eigenvector.</p>
    <PageRankVisualizer client:visible />
  </DemoChrome>
</section>

<style>
  .preview-demos {
    margin: 3rem auto 0;
    max-width: 60rem;
  }
  .preview-demos > :global(* + *) {
    margin-top: 2rem;
  }
  .preview-demos__lede {
    color: var(--color-text-muted);
    margin: 0.5rem 0 2rem;
  }
  .preview-demos__desc {
    color: var(--color-text-muted);
    font-size: 0.9375rem;
    margin: 0 0 0.75rem;
  }
</style>