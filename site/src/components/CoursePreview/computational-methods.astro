---
/**
 * Course demo preview — Computational Methods
 *
 * Mounted inside the Coming-Soon variant of /courses/computational-methods/ so visitors
 * can play with every demo built for this course before its written
 * reflection ships. Hero demo hydrates client:idle; the rest hydrate
 * client:visible to keep initial load cheap.
 *
 * Generated by scripts/generate-course-previews.ps1 — edit the manifest
 * there (not this file) when the demo list or descriptions change.
 */
import DemoChrome from "../demo-kit/DemoChrome.astro";
import { LorenzVisualizer } from "../demos/computational-methods/rk4-solver/LorenzVisualizer";
import { BisectionVisualizer } from "../demos/computational-methods/bisection/BisectionVisualizer";
import { DftVisualizer } from "../demos/computational-methods/dft/DftVisualizer";
import { GaussianEliminationVisualizer } from "../demos/computational-methods/gaussian-elimination/GaussianEliminationVisualizer";
import { LagrangeSplineVisualizer } from "../demos/computational-methods/lagrange-spline/LagrangeSplineVisualizer";
import { LeastSquaresVisualizer } from "../demos/computational-methods/least-squares/LeastSquaresVisualizer";
import { LuDecompositionVisualizer } from "../demos/computational-methods/lu-decomposition/LuDecompositionVisualizer";
import { MonteCarloIntegrationVisualizer } from "../demos/computational-methods/monte-carlo-integration/MonteCarloIntegrationVisualizer";
import { NewtonsMethodVisualizer } from "../demos/computational-methods/newtons-method/NewtonsMethodVisualizer";
import { PowerIterationVisualizer } from "../demos/computational-methods/power-iteration/PowerIterationVisualizer";
import { QuadratureVisualizer } from "../demos/computational-methods/quadrature/QuadratureVisualizer";
---

<section class="preview-demos" aria-labelledby="preview-demos-heading-computational-methods">
  <h2 id="preview-demos-heading-computational-methods">Preview the demos (11)</h2>
  <p class="preview-demos__lede">
    The interactive demos for this course are wired and playable below. The
    written reflection and featured problems land with the full course page —
    track progress on the <a
      href="https://github.com/Akosah285/engineering-portfolio/issues"
      >issue tracker</a
    >.
  </p>

  <DemoChrome
    title="Runge-Kutta ODE solver (Lorenz)"
    shareable={false}
    demoSourcePath="site/src/components/demos/computational-methods/rk4-solver/LorenzVisualizer.tsx"
  >
    <p class="preview-demos__desc">RK4 on the Lorenz system; tune σ/ρ/β and watch the strange attractor unfold.</p>
    <LorenzVisualizer client:idle />
  </DemoChrome>

  <DemoChrome
    title="Bisection method"
    shareable={false}
    demoSourcePath="site/src/components/demos/computational-methods/bisection/BisectionVisualizer.tsx"
  >
    <p class="preview-demos__desc">Bracket-and-halve root finding with live convergence trace.</p>
    <BisectionVisualizer client:visible />
  </DemoChrome>

  <DemoChrome
    title="Discrete Fourier transform"
    shareable={false}
    demoSourcePath="site/src/components/demos/computational-methods/dft/DftVisualizer.tsx"
  >
    <p class="preview-demos__desc">Stem plots for a signal's DFT amplitude + phase, with windowing options.</p>
    <DftVisualizer client:visible />
  </DemoChrome>

  <DemoChrome
    title="Gaussian elimination — step by step"
    shareable={false}
    demoSourcePath="site/src/components/demos/computational-methods/gaussian-elimination/GaussianEliminationVisualizer.tsx"
  >
    <p class="preview-demos__desc">Watch row operations reduce an augmented matrix to row-echelon form.</p>
    <GaussianEliminationVisualizer client:visible />
  </DemoChrome>

  <DemoChrome
    title="Lagrange vs cubic spline"
    shareable={false}
    demoSourcePath="site/src/components/demos/computational-methods/lagrange-spline/LagrangeSplineVisualizer.tsx"
  >
    <p class="preview-demos__desc">Add interpolation nodes; compare Runge's-phenomenon-prone Lagrange to natural cubic splines.</p>
    <LagrangeSplineVisualizer client:visible />
  </DemoChrome>

  <DemoChrome
    title="Least squares curve fitting"
    shareable={false}
    demoSourcePath="site/src/components/demos/computational-methods/least-squares/LeastSquaresVisualizer.tsx"
  >
    <p class="preview-demos__desc">Click to drop points; fit polynomials of varying degree with sum-of-squared-residuals.</p>
    <LeastSquaresVisualizer client:visible />
  </DemoChrome>

  <DemoChrome
    title="LU decomposition"
    shareable={false}
    demoSourcePath="site/src/components/demos/computational-methods/lu-decomposition/LuDecompositionVisualizer.tsx"
  >
    <p class="preview-demos__desc">Animate the LU factorisation step by step on a 4×4 matrix.</p>
    <LuDecompositionVisualizer client:visible />
  </DemoChrome>

  <DemoChrome
    title="Monte Carlo integration"
    shareable={false}
    demoSourcePath="site/src/components/demos/computational-methods/monte-carlo-integration/MonteCarloIntegrationVisualizer.tsx"
  >
    <p class="preview-demos__desc">Compare convergence rates of MC integration vs trapezoidal rule.</p>
    <MonteCarloIntegrationVisualizer client:visible />
  </DemoChrome>

  <DemoChrome
    title="Newton's method"
    shareable={false}
    demoSourcePath="site/src/components/demos/computational-methods/newtons-method/NewtonsMethodVisualizer.tsx"
  >
    <p class="preview-demos__desc">Tangent-line iteration with quadratic-convergence visualisation.</p>
    <NewtonsMethodVisualizer client:visible />
  </DemoChrome>

  <DemoChrome
    title="Eigenvalue power iteration"
    shareable={false}
    demoSourcePath="site/src/components/demos/computational-methods/power-iteration/PowerIterationVisualizer.tsx"
  >
    <p class="preview-demos__desc">Iterate Ax → x until the dominant eigenvector emerges.</p>
    <PowerIterationVisualizer client:visible />
  </DemoChrome>

  <DemoChrome
    title="Numerical integration comparator"
    shareable={false}
    demoSourcePath="site/src/components/demos/computational-methods/quadrature/QuadratureVisualizer.tsx"
  >
    <p class="preview-demos__desc">Side-by-side midpoint / trapezoidal / Simpson's rule error analysis.</p>
    <QuadratureVisualizer client:visible />
  </DemoChrome>
</section>

<style>
  .preview-demos {
    margin: 3rem auto 0;
    max-width: 60rem;
  }
  .preview-demos > :global(* + *) {
    margin-top: 2rem;
  }
  .preview-demos__lede {
    color: var(--color-text-muted);
    margin: 0.5rem 0 2rem;
  }
  .preview-demos__desc {
    color: var(--color-text-muted);
    font-size: 0.9375rem;
    margin: 0 0 0.75rem;
  }
</style>