---
/**
 * Course demo preview — Fourier Transforms & Complex Variables
 *
 * Mounted inside the Coming-Soon variant of /courses/fourier-transforms/ so visitors
 * can play with every demo built for this course before its written
 * reflection ships. Hero demo hydrates client:idle; the rest hydrate
 * client:visible to keep initial load cheap.
 *
 * Generated by scripts/generate-course-previews.ps1 — edit the manifest
 * there (not this file) when the demo list or descriptions change.
 */
import DemoChrome from "../demo-kit/DemoChrome.astro";
import { EpicycleVisualizer } from "../demos/fourier-transforms/epicycle/EpicycleVisualizer";
import { AudioFilterVisualizer } from "../demos/fourier-transforms/audio-filter/AudioFilterVisualizer";
import ConformalVisualizer from "../demos/fourier-transforms/conformal/ConformalVisualizer";
import { ConvolutionVisualizer } from "../demos/fourier-transforms/convolution/ConvolutionVisualizer";
import DomainColoringVisualizer from "../demos/fourier-transforms/domain-coloring/DomainColoringVisualizer";
import { FourierSeriesVisualizer } from "../demos/fourier-transforms/fourier-series/FourierSeriesVisualizer";
import { FtSignalsVisualizer } from "../demos/fourier-transforms/ft-signals/FtSignalsVisualizer";
import ResidueHelperVisualizer from "../demos/fourier-transforms/residue-helper/ResidueHelperVisualizer";
---

<section class="preview-demos" aria-labelledby="preview-demos-heading-fourier-transforms">
  <h2 id="preview-demos-heading-fourier-transforms">Preview the demos (8)</h2>
  <p class="preview-demos__lede">
    The interactive demos for this course are wired and playable below. The
    written reflection and featured problems land with the full course page —
    track progress on the <a
      href="https://github.com/Akosah285/engineering-portfolio/issues"
      >issue tracker</a
    >.
  </p>

  <DemoChrome
    title="Epicycle drawing animation"
    shareable={false}
    demoSourcePath="site/src/components/demos/fourier-transforms/epicycle/EpicycleVisualizer.tsx"
  >
    <p class="preview-demos__desc">Sum a chain of rotating vectors and reconstruct an arbitrary path as Fourier coefficients tune.</p>
    <EpicycleVisualizer client:idle />
  </DemoChrome>

  <DemoChrome
    title="Audio filter — Web Audio biquad"
    shareable={false}
    demoSourcePath="site/src/components/demos/fourier-transforms/audio-filter/AudioFilterVisualizer.tsx"
  >
    <p class="preview-demos__desc">Drag the cutoff and Q to hear how a biquad sculpts a synth or microphone signal.</p>
    <AudioFilterVisualizer client:visible />
  </DemoChrome>

  <DemoChrome
    title="Conformal mapping"
    shareable={false}
    demoSourcePath="site/src/components/demos/fourier-transforms/conformal/ConformalVisualizer.tsx"
  >
    <p class="preview-demos__desc">Watch how an analytic map deforms a grid while preserving angles.</p>
    <ConformalVisualizer client:visible />
  </DemoChrome>

  <DemoChrome
    title="Convolution animation"
    shareable={false}
    demoSourcePath="site/src/components/demos/fourier-transforms/convolution/ConvolutionVisualizer.tsx"
  >
    <p class="preview-demos__desc">Slide one signal past another and trace the running integral of their product.</p>
    <ConvolutionVisualizer client:visible />
  </DemoChrome>

  <DemoChrome
    title="Complex domain coloring"
    shareable={false}
    demoSourcePath="site/src/components/demos/fourier-transforms/domain-coloring/DomainColoringVisualizer.tsx"
  >
    <p class="preview-demos__desc">Phase-as-hue / magnitude-as-brightness visualisation of analytic functions.</p>
    <DomainColoringVisualizer client:visible />
  </DemoChrome>

  <DemoChrome
    title="Fourier series builder"
    shareable={false}
    demoSourcePath="site/src/components/demos/fourier-transforms/fourier-series/FourierSeriesVisualizer.tsx"
  >
    <p class="preview-demos__desc">Stack sine and cosine harmonics and watch the partial sums converge to square / sawtooth / triangle.</p>
    <FourierSeriesVisualizer client:visible />
  </DemoChrome>

  <DemoChrome
    title="Fourier transform of common signals"
    shareable={false}
    demoSourcePath="site/src/components/demos/fourier-transforms/ft-signals/FtSignalsVisualizer.tsx"
  >
    <p class="preview-demos__desc">Side-by-side time-domain and frequency-domain plots for canonical signals.</p>
    <FtSignalsVisualizer client:visible />
  </DemoChrome>

  <DemoChrome
    title="Residue theorem helper"
    shareable={false}
    demoSourcePath="site/src/components/demos/fourier-transforms/residue-helper/ResidueHelperVisualizer.tsx"
  >
    <p class="preview-demos__desc">Compute residues at poles inside a contour and verify against the contour integral.</p>
    <ResidueHelperVisualizer client:visible />
  </DemoChrome>
</section>

<style>
  .preview-demos {
    margin: 3rem auto 0;
    max-width: 60rem;
  }
  .preview-demos > :global(* + *) {
    margin-top: 2rem;
  }
  .preview-demos__lede {
    color: var(--color-text-muted);
    margin: 0.5rem 0 2rem;
  }
  .preview-demos__desc {
    color: var(--color-text-muted);
    font-size: 0.9375rem;
    margin: 0 0 0.75rem;
  }
</style>