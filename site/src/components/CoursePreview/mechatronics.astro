---
/**
 * Course demo preview — Mechatronics
 *
 * Mounted inside the Coming-Soon variant of /courses/mechatronics/ so visitors
 * can play with every demo built for this course before its written
 * reflection ships. Hero demo hydrates client:idle; the rest hydrate
 * client:visible to keep initial load cheap.
 *
 * Generated by scripts/generate-course-previews.ps1 — edit the manifest
 * there (not this file) when the demo list or descriptions change.
 */
import DemoChrome from "../demo-kit/DemoChrome.astro";
import { PidControllerVisualizer } from "../demos/mechatronics/pid-controller/PidControllerVisualizer";
import { BodePlotVisualizer } from "../demos/mechatronics/bode-plot/BodePlotVisualizer";
import { DcMotorVisualizer } from "../demos/mechatronics/dc-motor/DcMotorVisualizer";
import MazePathfindVisualizer from "../demos/mechatronics/maze-pathfind/MazePathfindVisualizer";
import SensorFusionVisualizer from "../demos/mechatronics/sensor-fusion/SensorFusionVisualizer";
import { StateMachineVisualizer } from "../demos/mechatronics/state-machine/StateMachineVisualizer";
import StepPositionVisualizer from "../demos/mechatronics/step-position/StepPositionVisualizer";
import { TwoLinkIkVisualizer } from "../demos/mechatronics/two-link-ik/TwoLinkIkVisualizer";
---

<section class="preview-demos" aria-labelledby="preview-demos-heading-mechatronics">
  <h2 id="preview-demos-heading-mechatronics">Preview the demos (8)</h2>
  <p class="preview-demos__lede">
    The interactive demos for this course are wired and playable below. The
    written reflection and featured problems land with the full course page —
    track progress on the <a
      href="https://github.com/Akosah285/engineering-portfolio/issues"
      >issue tracker</a
    >.
  </p>

  <DemoChrome
    title="PID step response"
    shareable={false}
    demoSourcePath="site/src/components/demos/mechatronics/pid-controller/PidControllerVisualizer.tsx"
  >
    <p class="preview-demos__desc">Tune Kp / Ki / Kd; watch overshoot, rise time, and steady-state error change live.</p>
    <PidControllerVisualizer client:idle />
  </DemoChrome>

  <DemoChrome
    title="Bode plot builder"
    shareable={false}
    demoSourcePath="site/src/components/demos/mechatronics/bode-plot/BodePlotVisualizer.tsx"
  >
    <p class="preview-demos__desc">Compose poles and zeros; live magnitude + phase Bode plots.</p>
    <BodePlotVisualizer client:visible />
  </DemoChrome>

  <DemoChrome
    title="DC motor model"
    shareable={false}
    demoSourcePath="site/src/components/demos/mechatronics/dc-motor/DcMotorVisualizer.tsx"
  >
    <p class="preview-demos__desc">First-order DC motor response to a step voltage with adjustable back-EMF and inertia.</p>
    <DcMotorVisualizer client:visible />
  </DemoChrome>

  <DemoChrome
    title="Maze pathfinding"
    shareable={false}
    demoSourcePath="site/src/components/demos/mechatronics/maze-pathfind/MazePathfindVisualizer.tsx"
  >
    <p class="preview-demos__desc">BFS / DFS / A* search on a small grid maze with frontier visualisation.</p>
    <MazePathfindVisualizer client:visible />
  </DemoChrome>

  <DemoChrome
    title="Sensor fusion — encoder + IMU"
    shareable={false}
    demoSourcePath="site/src/components/demos/mechatronics/sensor-fusion/SensorFusionVisualizer.tsx"
  >
    <p class="preview-demos__desc">Complementary filter combining wheel encoders and a noisy IMU for heading estimation.</p>
    <SensorFusionVisualizer client:visible />
  </DemoChrome>

  <DemoChrome
    title="State machine — decision_making"
    shareable={false}
    demoSourcePath="site/src/components/demos/mechatronics/state-machine/StateMachineVisualizer.tsx"
  >
    <p class="preview-demos__desc">Step through the robot's behaviour FSM transitions, lifted from decision_making.ino.</p>
    <StateMachineVisualizer client:visible />
  </DemoChrome>

  <DemoChrome
    title="Step position control"
    shareable={false}
    demoSourcePath="site/src/components/demos/mechatronics/step-position/StepPositionVisualizer.tsx"
  >
    <p class="preview-demos__desc">Step-input position controller with closed-loop tracking visualisation.</p>
    <StepPositionVisualizer client:visible />
  </DemoChrome>

  <DemoChrome
    title="2-link inverse kinematics"
    shareable={false}
    demoSourcePath="site/src/components/demos/mechatronics/two-link-ik/TwoLinkIkVisualizer.tsx"
  >
    <p class="preview-demos__desc">Drag an end-effector target; solve joint angles for a 2-DOF planar arm.</p>
    <TwoLinkIkVisualizer client:visible />
  </DemoChrome>
</section>

<style>
  .preview-demos {
    margin: 3rem auto 0;
    max-width: 60rem;
  }
  .preview-demos > :global(* + *) {
    margin-top: 2rem;
  }
  .preview-demos__lede {
    color: var(--color-text-muted);
    margin: 0.5rem 0 2rem;
  }
  .preview-demos__desc {
    color: var(--color-text-muted);
    font-size: 0.9375rem;
    margin: 0 0 0.75rem;
  }
</style>