---
/**
 * Course demo preview — Distributed Systems & Fields
 *
 * Mounted inside the Coming-Soon variant of /courses/distributed-systems/ so visitors
 * can play with every demo built for this course before its written
 * reflection ships. Hero demo hydrates client:idle; the rest hydrate
 * client:visible to keep initial load cheap.
 *
 * Generated by scripts/generate-course-previews.ps1 — edit the manifest
 * there (not this file) when the demo list or descriptions change.
 */
import DemoChrome from "../demo-kit/DemoChrome.astro";
import ChargeFieldVisualizer from "../demos/distributed-systems/charge-field/ChargeFieldVisualizer";
import BiotSavartVisualizer from "../demos/distributed-systems/biot-savart/BiotSavartVisualizer";
import FaradayVisualizer from "../demos/distributed-systems/faraday/FaradayVisualizer";
import { HeatEquationVisualizer } from "../demos/distributed-systems/heat-equation/HeatEquationVisualizer";
import LaplaceRectVisualizer from "../demos/distributed-systems/laplace-rect/LaplaceRectVisualizer";
import RcRlVisualizer from "../demos/distributed-systems/rc-rl/RcRlVisualizer";
import VectorFieldVisualizer from "../demos/distributed-systems/vector-field/VectorFieldVisualizer";
import Wave2DVisualizer from "../demos/distributed-systems/wave-2d/Wave2DVisualizer";
import WaveEquationVisualizer from "../demos/distributed-systems/wave-equation/WaveEquationVisualizer";
---

<section class="preview-demos" aria-labelledby="preview-demos-heading-distributed-systems">
  <h2 id="preview-demos-heading-distributed-systems">Preview the demos (9)</h2>
  <p class="preview-demos__lede">
    The interactive demos for this course are wired and playable below. The
    written reflection and featured problems land with the full course page —
    track progress on the <a
      href="https://github.com/Akosah285/engineering-portfolio/issues"
      >issue tracker</a
    >.
  </p>

  <DemoChrome
    title="Charge field plotter"
    shareable={false}
    demoSourcePath="site/src/components/demos/distributed-systems/charge-field/ChargeFieldVisualizer.tsx"
  >
    <p class="preview-demos__desc">Drop point charges; live E-field arrows + equipotential contours.</p>
    <ChargeFieldVisualizer client:idle />
  </DemoChrome>

  <DemoChrome
    title="Biot-Savart B-field"
    shareable={false}
    demoSourcePath="site/src/components/demos/distributed-systems/biot-savart/BiotSavartVisualizer.tsx"
  >
    <p class="preview-demos__desc">Magnetic field from a current loop or coil, visualised as field lines and arrows.</p>
    <BiotSavartVisualizer client:visible />
  </DemoChrome>

  <DemoChrome
    title="Faraday's law / induced EMF"
    shareable={false}
    demoSourcePath="site/src/components/demos/distributed-systems/faraday/FaradayVisualizer.tsx"
  >
    <p class="preview-demos__desc">Slide a magnet through a coil; live flux and induced EMF traces.</p>
    <FaradayVisualizer client:visible />
  </DemoChrome>

  <DemoChrome
    title="1D heat equation"
    shareable={false}
    demoSourcePath="site/src/components/demos/distributed-systems/heat-equation/HeatEquationVisualizer.tsx"
  >
    <p class="preview-demos__desc">Finite-difference solver for heat diffusion along a rod; tune boundary conditions.</p>
    <HeatEquationVisualizer client:visible />
  </DemoChrome>

  <DemoChrome
    title="Laplace in a rectangle"
    shareable={false}
    demoSourcePath="site/src/components/demos/distributed-systems/laplace-rect/LaplaceRectVisualizer.tsx"
  >
    <p class="preview-demos__desc">Iterative Laplace solver on a rectangular domain with mixed Dirichlet boundaries.</p>
    <LaplaceRectVisualizer client:visible />
  </DemoChrome>

  <DemoChrome
    title="RC / RL step response"
    shareable={false}
    demoSourcePath="site/src/components/demos/distributed-systems/rc-rl/RcRlVisualizer.tsx"
  >
    <p class="preview-demos__desc">First-order circuit step + frequency response side by side.</p>
    <RcRlVisualizer client:visible />
  </DemoChrome>

  <DemoChrome
    title="Vector field visualizer"
    shareable={false}
    demoSourcePath="site/src/components/demos/distributed-systems/vector-field/VectorFieldVisualizer.tsx"
  >
    <p class="preview-demos__desc">Type any 2D vector field; render its arrows, divergence, and curl.</p>
    <VectorFieldVisualizer client:visible />
  </DemoChrome>

  <DemoChrome
    title="2D wave interference"
    shareable={false}
    demoSourcePath="site/src/components/demos/distributed-systems/wave-2d/Wave2DVisualizer.tsx"
  >
    <p class="preview-demos__desc">Two-source interference pattern with adjustable phase, frequency, and separation.</p>
    <Wave2DVisualizer client:visible />
  </DemoChrome>

  <DemoChrome
    title="1D wave equation (string)"
    shareable={false}
    demoSourcePath="site/src/components/demos/distributed-systems/wave-equation/WaveEquationVisualizer.tsx"
  >
    <p class="preview-demos__desc">Plucked-string wave equation with reflective boundary conditions.</p>
    <WaveEquationVisualizer client:visible />
  </DemoChrome>
</section>

<style>
  .preview-demos {
    margin: 3rem auto 0;
    max-width: 60rem;
  }
  .preview-demos > :global(* + *) {
    margin-top: 2rem;
  }
  .preview-demos__lede {
    color: var(--color-text-muted);
    margin: 0.5rem 0 2rem;
  }
  .preview-demos__desc {
    color: var(--color-text-muted);
    font-size: 0.9375rem;
    margin: 0 0 0.75rem;
  }
</style>