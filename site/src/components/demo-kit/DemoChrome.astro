---
/**
 * <DemoChrome> — the visible wrapper around every interactive demo
 * (plan §3.1, #14).
 *
 * Provides:
 *   - Bordered Pine-tinted card (~12px radius)
 *   - Title at the top
 *   - "Try it" badge top-right
 *   - <slot/> for the demo itself
 *   - <slot name="about"/> rendered inside a collapsed
 *     <details> "About this demo"
 *   - Auto-rendered <ShareButton> when `shareable` is true
 *   - Always-present "View on GitHub" link (built from
 *     `demoSourcePath` + repo base URL)
 *   - Auto-rendered <DemoNoScriptFallback> when `narration` prop set
 *
 * The chrome is pure Astro — no client JS for the chrome itself.
 * Children may hydrate independently with `client:idle` / `client:visible`.
 *
 * Usage:
 *   <DemoChrome
 *     title="Gradient Descent"
 *     shareable={true}
 *     demoSourcePath="site/src/components/demos/ml/gradient-descent/Component.tsx"
 *     narration="An animated visualization of gradient descent on a parabola."
 *   >
 *     <MyDemo client:visible />
 *     <Fragment slot="about">
 *       This demo shows how gradient descent ...
 *     </Fragment>
 *   </DemoChrome>
 */
import ShareButton from "./ShareButton.astro";
import DemoNoScriptFallback from "./DemoNoScriptFallback.astro";
import { buildGitHubSourceUrl } from "./demoChrome";

interface Props {
  /** Title shown at the top of the chrome. */
  title: string;
  /** Whether to auto-render <ShareButton>. Default: false. */
  shareable?: boolean;
  /**
   * Repo-relative path to the demo's source file. Required so the
   * "View on GitHub" link always points at the right code.
   */
  demoSourcePath: string;
  /**
   * Plain-English description of the demo. When set, also renders
   * <DemoNoScriptFallback narration={narration} /> for JS-disabled
   * visitors.
   */
  narration?: string;
  /** Override the repo URL. Defaults to the project repo. */
  repoBaseUrl?: string;
  /** Override the branch. Defaults to "main". */
  branch?: string;
}

const {
  title,
  shareable = false,
  demoSourcePath,
  narration,
  repoBaseUrl = "https://github.com/Akosah285/engineering-portfolio",
  branch = "main",
} = Astro.props;

const githubUrl = buildGitHubSourceUrl(repoBaseUrl, demoSourcePath, branch);
const titleId = `demo-chrome-title-${Math.random().toString(36).slice(2, 10)}`;
---

<section class="demo-chrome" aria-labelledby={titleId}>
  <header class="demo-chrome__header">
    <h3 class="demo-chrome__title" id={titleId}>{title}</h3>
    <span class="demo-chrome__badge" aria-hidden="true">Try it</span>
  </header>

  <div class="demo-chrome__body">
    <slot />
  </div>

  {narration && <DemoNoScriptFallback narration={narration} />}

  <footer class="demo-chrome__footer">
    {shareable && <ShareButton />}
    <a
      class="demo-chrome__source"
      href={githubUrl}
      target="_blank"
      rel="noopener noreferrer"
    >
      View on GitHub
      <svg
        width="12"
        height="12"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M7 17l9.2-9.2M17 17V7H7"></path>
      </svg>
    </a>
  </footer>

  <details class="demo-chrome__about">
    <summary class="demo-chrome__about-summary">About this demo</summary>
    <div class="demo-chrome__about-body">
      <slot name="about" />
    </div>
  </details>
</section>

<style>
  .demo-chrome {
    /* Pine-tinted card per plan §2.6 */
    margin: 2rem 0;
    border: 1px solid color-mix(in srgb, var(--color-accent) 30%, var(--color-text-muted));
    border-radius: 12px;
    background: var(--color-surface);
    overflow: hidden;
  }

  .demo-chrome__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.875rem 1.25rem;
    border-bottom: 1px solid var(--color-text-muted);
    /* Subtle Pine tint */
    background: color-mix(in srgb, var(--color-accent) 6%, var(--color-surface));
  }

  .demo-chrome__title {
    margin: 0;
    font-family: "Source Serif 4 Variable", Georgia, serif;
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-text);
  }

  .demo-chrome__badge {
    padding: 0.1875rem 0.625rem;
    border-radius: 999px;
    background: var(--color-accent);
    color: var(--color-bg);
    font-family: "Inter Variable", sans-serif;
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .demo-chrome__body {
    padding: 1.25rem;
  }

  .demo-chrome__footer {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.75rem;
    padding: 0.625rem 1.25rem;
    border-top: 1px solid var(--color-text-muted);
    background: color-mix(in srgb, var(--color-accent) 3%, var(--color-surface));
  }

  .demo-chrome__source {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    color: var(--color-text);
    font-size: 0.8125rem;
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 0.15s ease, color 0.15s ease;
  }

  .demo-chrome__source:hover,
  .demo-chrome__source:focus-visible {
    color: var(--color-accent);
    border-bottom-color: var(--color-accent);
  }

  .demo-chrome__source:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
    border-radius: 2px;
  }

  .demo-chrome__about {
    border-top: 1px solid var(--color-text-muted);
  }

  .demo-chrome__about-summary {
    cursor: pointer;
    padding: 0.625rem 1.25rem;
    font-size: 0.875rem;
    color: var(--color-text);
    list-style: none;
    user-select: none;
  }

  .demo-chrome__about-summary::-webkit-details-marker {
    display: none;
  }

  .demo-chrome__about-summary::before {
    content: "›";
    display: inline-block;
    margin-right: 0.375rem;
    color: var(--color-accent);
    font-size: 1.125rem;
    line-height: 1;
    transition: transform 0.2s ease;
  }

  .demo-chrome__about[open] > .demo-chrome__about-summary::before {
    transform: rotate(90deg);
  }

  .demo-chrome__about-body {
    padding: 0 1.25rem 1.25rem;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-text);
  }
</style>
