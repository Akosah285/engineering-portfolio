---
/**
 * <TryThis> — a "do this on the demo above" callout inside a <Step>.
 *
 * Renders as a styled aside so readers visually distinguish "go press
 * the slider" instructions from regular exposition. Optional per step
 * but every <Explainer> needs at least one (enforced by
 * explainers.test.ts).
 */
---

<aside class="try-this" role="note">
  <span class="try-this__label" aria-hidden="true">Try it</span>
  <div class="try-this__body">
    <slot />
  </div>
</aside>

<style>
  .try-this {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    margin: 0.75rem 0;
    padding: 0.625rem 0.875rem;
    border-left: 3px solid var(--color-accent);
    border-radius: 6px;
    background: color-mix(in srgb, var(--color-accent) 8%, var(--color-surface));
  }
  .try-this__label {
    flex-shrink: 0;
    padding: 0.125rem 0.5rem;
    border-radius: 999px;
    background: var(--color-accent);
    color: var(--color-bg);
    font-family: "Inter Variable", sans-serif;
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    line-height: 1.4;
  }
  .try-this__body {
    flex: 1;
    color: var(--color-text);
    font-family: "Source Serif 4 Variable", Georgia, serif;
    font-size: 0.9375rem;
    line-height: 1.55;
  }
  .try-this__body :global(p) {
    margin: 0;
  }
  .try-this__body :global(p + p) {
    margin-top: 0.5rem;
  }
</style>
